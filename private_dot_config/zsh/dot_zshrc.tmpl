#!/usr/bin/env zsh

# TODO (Chris): Move git-extras checks to its own file.
# TODO (Chris): Speed up searching for git-extras autocompletion for other OSes.

# If not running interactively, do nothing.
[[ $- != *i* ]] && return

export LANG=en_US.UTF-8

# Make sure zinit is installed.
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
ZINIT_INIT="${ZINIT_HOME}/zinit.zsh"
if [[ ! -d ${ZINIT_HOME} ]]; then
    mkdir -p "${ZINIT_HOME}"
    if ((! pipestatus)); then
        git clone "https://github.com/zdharma-continuum/zinit.git" "${ZINIT_HOME}"
    fi
fi

if [[ ! -f ${ZINIT_INIT} ]]; then
    echo "ERROR: Could not find 'zinit'! Shell experience will be degraded."
else
    source ${ZINIT_INIT}
fi

# Load modules
zmodload zsh/computil zsh/complist

# Read in my configuration files
source ${ZDOTCONFDIR:-~/.config/zsh/conf.d}/zsh_options
source ${ZDOTCONFDIR:-~/.config/zsh/conf.d}/zsh_plugins
source ${ZDOTCONFDIR:-~/.config/zsh/conf.d}/zsh_keybindings
source ${ZDOTCONFDIR:-~/.config/zsh/conf.d}/zsh_functions
source ${ZDOTCONFDIR:-~/.config/zsh/conf.d}/zsh_aliases

# autoloads
autoload -U compaudit compinit zrecompile
autoload -U up-line-or-beginning-search down-line-or-beginning-search

# Call the prompt function
eval "$(starship init zsh)"

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
    export EDITOR=vim
else
    if (( ${+commands[zed]} )); then
        export EDITOR=zed
    elif (( ${+commands[cursor]} )); then
        export EDITOR=cursor
    elif (( ${+commands[code]} )); then
        export EDITOR=code
    else
        export EDITOR=vim
    fi
fi

# Vim variables
export VIMINIT='let $MYVIMRC="$XDG_CONFIG_HOME/vim/vimrc" | source $MYVIMRC'

# Set the path. Listed in priority order: the first entry wins. Unset
# variables drop out of the array at assignment; (N-/) keeps only entries
# that resolve to existing directories. typeset -U on both names keeps PATH
# free of duplicates for the life of the shell, including later scalar
# prepends by tools like nvm and pyenv.
typeset -U path PATH
path_dirs=(
    ${NVM_BIN}
    ${HOMEBREW_PREFIX:-/opt/homebrew}/sbin
    ${HOMEBREW_PREFIX:-/opt/homebrew}/bin
    ${HOME}/.local/bin
    ${HOME}/bin
    /usr/local/aws/bin
    ${HOME}/go/bin
    ${HOME}/Qt
    ${PYENV_ROOT}/shims
)
path=(${^path_dirs}(N-/) $path)
export PATH
